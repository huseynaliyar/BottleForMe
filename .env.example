# Copy to .env.local and fill in values from a development Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. In Vercel, set it as a server environment variable.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only key for Malta address suggestions.
GOOGLE_PLACES_API_KEY=

# Server only. Comma-separated Supabase Auth user IDs allowed to open /admin.
BOTTLEFORME_ADMIN_USER_IDS=
