# ==============================================================================
# BottleForMe - Environment Variables
# Copy this file to .env.local for local testing: cp .env.example .env.local
# Add these variables to your Vercel Project Settings -> Environment Variables
# ==============================================================================

# 1. Supabase (Free tier at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Base App URL (auto-set by Vercel in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
